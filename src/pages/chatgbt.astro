---
const formUrl = 'https://api.leadconnectorhq.com/widget/survey/rrhhWizJieUS6ahos0eq?notrack=true';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ChatGBT application landing page" />
    <title>ChatGBT</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f7f7f8;
        --panel: #ffffff;
        --text: #202123;
        --muted: #6b6c7b;
        --line: #e5e5e8;
        --accent: #10a37f;
        --accent-hover: #0d8f70;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      .shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 270px 1fr;
      }

      .sidebar {
        position: sticky;
        top: 0;
        height: 100vh;
        padding: 18px;
        background: #171717;
        color: #f4f4f4;
        display: flex;
        flex-direction: column;
        gap: 18px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        font-size: 18px;
      }

      .brand-mark {
        width: 32px;
        height: 32px;
        border: 1px solid #3b3b3b;
        border-radius: 9px;
        display: grid;
        place-items: center;
        background: #232323;
        font-size: 15px;
      }

      .new-chat {
        border: 1px solid #3d3d3d;
        border-radius: 10px;
        padding: 12px 14px;
        color: #ececec;
        background: #212121;
        font-size: 14px;
      }

      .side-copy {
        margin-top: auto;
        color: #a9a9b0;
        font-size: 12px;
        line-height: 1.5;
      }

      main {
        min-width: 0;
        padding: 36px 22px 70px;
      }

      .topbar {
        max-width: 980px;
        margin: 0 auto 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .model-name {
        font-weight: 600;
        color: #40414f;
      }

      .secure {
        font-size: 13px;
        color: var(--muted);
      }

      .content {
        max-width: 920px;
        margin: 0 auto;
      }

      .intro {
        text-align: center;
        padding: 22px 14px 30px;
      }

      .intro-badge {
        width: 54px;
        height: 54px;
        margin: 0 auto 18px;
        border-radius: 16px;
        display: grid;
        place-items: center;
        background: #111;
        color: #fff;
        font-weight: 800;
        letter-spacing: -0.04em;
        box-shadow: 0 10px 30px rgba(0,0,0,.12);
      }

      h1 {
        margin: 0;
        font-size: clamp(32px, 5vw, 50px);
        line-height: 1.05;
        letter-spacing: -0.04em;
      }

      .intro p {
        max-width: 680px;
        margin: 16px auto 0;
        color: var(--muted);
        font-size: 17px;
        line-height: 1.65;
      }

      .conversation {
        display: grid;
        gap: 14px;
        margin-bottom: 22px;
      }

      .message {
        border-radius: 18px;
        padding: 16px 18px;
        line-height: 1.55;
        font-size: 15px;
      }

      .message.user {
        margin-left: auto;
        max-width: 78%;
        background: #ececec;
      }

      .message.assistant {
        max-width: 82%;
        padding-left: 0;
        background: transparent;
      }

      .form-card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 22px;
        box-shadow: 0 14px 50px rgba(0,0,0,.07);
        overflow: hidden;
      }

      .form-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 20px;
        border-bottom: 1px solid var(--line);
      }

      .form-header strong { font-size: 16px; }
      .form-header span { color: var(--muted); font-size: 12px; }

      .form-frame {
        width: 100%;
        min-height: 760px;
        border: 0;
        display: block;
        background: #fff;
      }

      .composer {
        margin: 22px auto 0;
        max-width: 780px;
        background: #fff;
        border: 1px solid #dedee3;
        border-radius: 26px;
        padding: 14px 17px;
        color: #8a8b94;
        box-shadow: 0 7px 25px rgba(0,0,0,.05);
        font-size: 14px;
      }

      footer {
        max-width: 920px;
        margin: 26px auto 0;
        text-align: center;
        color: #8b8c95;
        font-size: 11px;
        line-height: 1.5;
      }

      @media (max-width: 780px) {
        .shell { grid-template-columns: 1fr; }
        .sidebar { display: none; }
        main { padding: 22px 12px 48px; }
        .topbar { padding: 0 4px; }
        .intro { padding-top: 10px; }
        .message.user, .message.assistant { max-width: 92%; }
        .form-frame { min-height: 820px; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar" aria-label="Chat navigation">
        <div class="brand"><div class="brand-mark">CG</div><span>ChatGBT</span></div>
        <div class="new-chat">＋ New conversation</div>
        <div class="side-copy">Private application session<br />Your information is submitted through the secure form.</div>
      </aside>

      <main>
        <div class="topbar">
          <div class="model-name">ChatGBT</div>
          <div class="secure">Secure application</div>
        </div>

        <section class="content">
          <div class="intro">
            <div class="intro-badge">CG</div>
            <h1>How can we help your business today?</h1>
            <p>Answer a few quick questions below so we can review your business information and determine the next best step.</p>
          </div>

          <div class="conversation" aria-hidden="true">
            <div class="message user">I’m looking for options for my business.</div>
            <div class="message assistant">Absolutely. Complete the short application below and we’ll use your answers to guide the review.</div>
          </div>

          <div class="form-card">
            <div class="form-header">
              <strong>Start your review</strong>
              <span>Usually takes only a few minutes</span>
            </div>
            <iframe
              class="form-frame"
              src={formUrl}
              title="ChatGBT application form"
              loading="eager"
              allow="clipboard-write"
            ></iframe>
          </div>

          <div class="composer">Message ChatGBT…</div>
        </section>

        <footer>
          ChatGBT is an independent landing page and is not affiliated with, endorsed by, or sponsored by OpenAI or ChatGPT.
        </footer>
      </main>
    </div>
  </body>
</html>
